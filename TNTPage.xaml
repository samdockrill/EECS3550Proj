<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutriWeekMAUI.TNTPage"
             xmlns:viewmodel="clr-namespace:NutriWeekMAUI.ViewModels"
             x:DataType="viewmodel:TNTViewModel"
             Title="Tap 'n Type"
             BackgroundColor="White">

    <Grid
    RowDefinitions="Auto, Auto, *, Auto"
    ColumnDefinitions=".75*, .25*"
    Padding="10"
    RowSpacing="10"
    ColumnSpacing="10">

        <Label
            Text="Enter a new Food item:"
            Grid.ColumnSpan="2"
            FontSize="25"
            TextColor="DarkSlateGray"
            VerticalOptions="Center"
            HorizontalOptions="Start"/>


        <Entry
            Placeholder="Food Name"
            Grid.Row="1"
            TextColor="DarkSlateGray"
            BackgroundColor="MediumAquamarine"/>

        <Button
            x:Name="EnterBtn"
            Grid.Row="1"
            Grid.Column="1"
            BackgroundColor="MediumSeaGreen"
            Text="Search"
            Command="{Binding GetSearchResultsCommand}"
            TextColor="DarkSlateGray"
            BorderColor="DarkSlateGray"
            BorderWidth="2"
            VerticalOptions="Center" />

        <CollectionView
            Grid.Row="2"
            Grid.ColumnSpan="2"
            ItemsSource="{Binding Foods}"
            SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate
                    x:DataType="{x:Type x:String}">
                    <Grid
                        x:Name="FoodGrid"
                            Padding="0, 10"
                            IsVisible="False">
                            <Border
                                BackgroundColor="DarkSlateGray">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:TNTViewModel}}, Path=AddToDayCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <Label Text="{Binding .}"
                                    FontSize="30"
                                    BackgroundColor="MediumSeaGreen"
                                    TextColor="DarkSlateGray"/>
                            </Border>
                        </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button
            x:Name="BackBtn"
            Grid.Row="3"
            Grid.ColumnSpan="2"
            BackgroundColor="MediumSeaGreen"
            Text="Go Back"
            TextColor="DarkSlateGray"
            BorderColor="DarkSlateGray"
            BorderWidth="2"
            SemanticProperties.Hint="Navigates to the WeeksPage content page"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Command="{Binding BackToWeeksCommand}"/>

    </Grid>
</ContentPage>