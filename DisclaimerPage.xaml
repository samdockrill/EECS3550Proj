<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutriWeekMAUI.DisclaimerPage"
             xmlns:viewmodel="clr-namespace:NutriWeekMAUI.ViewModels"
             x:DataType="viewmodel:DisclaimerViewModel"
             Title="Disclaimer Page"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout
        Padding="30,0"
        Spacing="50">

            <Label
            Text="Disclaimer"
            TextColor="DarkSlateGray"
            Padding="30"
            Style="{StaticResource Headline}"
            SemanticProperties.HeadingLevel="Level1" />

            <Label
            Text="This prototype of the NutriWeek Meal Planner and Tracker does not factor potential allergies in the information collected for chosen food."
            FontSize="18"
            TextColor="DarkSlateGray"
            SemanticProperties.HeadingLevel="Level2"
            SemanticProperties.Description="Disclaimer Pt. 1" />

            <Label
            Text="It is important that you be aware of what types of ingredients might cause a potential allergic reaction for you."
            FontSize="18"
            TextColor="DarkSlateGray"
            SemanticProperties.HeadingLevel="Level3"
            SemanticProperties.Description="Disclaimer Pt. 2" />

            <Label
            Text="Please consult a doctor and review desired food items thoroughly before using the NutriWeek prototype."
            FontSize="18"
            TextColor="DarkSlateGray"
            SemanticProperties.HeadingLevel="Level4"
            SemanticProperties.Description="Disclaimer Pt. 3" />

            <Button
            x:Name="DisclaimerBtn"
            BackgroundColor="MediumSeaGreen"
            Text="I Understand"
            TextColor="DarkSlateGray"
            BorderColor="DarkSlateGray"
            BorderWidth="2"
            SemanticProperties.Hint="Navigates to a WeeksPage content page"
            HorizontalOptions="Fill"
            Command="{Binding GoToWeeksPageCommand}"/>

            <Button
            x:Name="BackBtn"
            BackgroundColor="MediumSeaGreen"
            Text="Go Back"
            TextColor="DarkSlateGray"
            BorderColor="DarkSlateGray"
            BorderWidth="2"
            SemanticProperties.Hint="Navigates back to a MainPage content page"
            HorizontalOptions="Fill"
            Command="{Binding BackToMainPageCommand}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>