<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutriWeekMAUI.MainPage"
             xmlns:viewmodel="clr-namespace:NutriWeekMAUI.ViewModels"
             x:DataType="viewmodel:MainViewModel"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Image
                Source="nurtiweek_2.jpg"
                HeightRequest="300"
                Aspect="AspectFit"
                SemanticProperties.Description="nutriweek placeholder logo" />

            <Label
                Text="Welcome to NutriWeek!"
                TextColor="DarkSlateGray"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="A weekly meal&#10;planner and tracker"
                TextColor="DarkSlateGray"
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2"
                SemanticProperties.Description="General description of the NutriWeek application" />

            <Button
                x:Name="CounterBtn"
                BackgroundColor="MediumSeaGreen"
                Text="Get started!"
                TextColor="DarkSlateGray"
                BorderColor="DarkSlateGray"
                BorderWidth="2"
                SemanticProperties.Hint="Navigates to the Disclaimer content page"
                HorizontalOptions="Fill"
                Command="{Binding GoToDisclaimerPageCommand}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
