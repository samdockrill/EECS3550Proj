<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutriWeekMAUI.WeeksPage"
             xmlns:viewmodel="clr-namespace:NutriWeekMAUI.ViewModels"
             x:DataType="viewmodel:WeeksViewModel"
             Title="Weekly View"
             BackgroundColor="White">

    <Grid
        RowDefinitions="Auto"
        ColumnDefinitions=".75*, .25*"
        Padding="10"
        RowSpacing="10"
        ColumnSpacing="10">

        <CollectionView
            Grid.ColumnSpan="2"
            ItemsSource="{Binding Weeks}"
            SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate
                    x:DataType="{x:Type x:String}">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Clear"
                                           BackgroundColor="Firebrick"/>
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Grid
                            Padding="0, 10">
                            <Border
                            BackgroundColor="DarkSlateGray">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:WeeksViewModel}}, Path=GoToWeekCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <Label Text="{Binding .}"
                                   FontSize="40"
                                   BackgroundColor="MediumSeaGreen"
                                   TextColor="DarkSlateGray"/>
                            </Border>
                        </Grid>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>