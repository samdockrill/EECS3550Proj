<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutriWeekMAUI.MInputPage"
             xmlns:viewmodel="clr-namespace:NutriWeekMAUI.ViewModels"
             x:DataType="viewmodel:MInputViewModel"
             Title="Manual Input"
             BackgroundColor="White">

    <ScrollView>
    <Grid
    RowDefinitions="*, *, *, *, *, *, *, *, *, *, *, *, *, *, *, *, *, *, *, *, *, Auto, Auto"
    ColumnDefinitions=".75*, .25*"
    Padding="10"
    RowSpacing="10"
    ColumnSpacing="10">

        <Entry
            Grid.ColumnSpan="2"
            Placeholder="Food Name"
            TextColor="DarkSlateGray" />

        <Entry
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Placeholder="Fat Value"
            TextColor="DarkSlateGray" />

        <Entry
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Placeholder="Sat-Fat Value"
            TextColor="DarkSlateGray"/>

        <Entry
            Grid.Row="3"
            Grid.ColumnSpan="2"
            Placeholder="Trans-Fat Value"
            TextColor="DarkSlateGray" />

        <Entry
            Grid.Row="4"
            Grid.ColumnSpan="2"
            Placeholder="Cholestrerol Value"
            TextColor="DarkSlateGray" />

        <Entry
            Grid.Row="5"
            Grid.ColumnSpan="2"
            Placeholder="Carb Value"
            TextColor="DarkSlateGray" />

        <Entry
            Grid.Row="6"
            Grid.ColumnSpan="2"
            Placeholder="Sugar Value"
            TextColor="DarkSlateGray" />

        <Entry
            Grid.Row="7"
            Grid.ColumnSpan="2"
            Placeholder="Fiber Value"
            TextColor="DarkSlateGray" />

        <Entry
            Grid.Row="8"
            Grid.ColumnSpan="2"
            Placeholder="Protein Value"
            TextColor="DarkSlateGray" />

        <Entry
            Grid.Row="9"
            Grid.ColumnSpan="2"
            Placeholder="Sodium Value"
            TextColor="DarkSlateGray" />

        <Entry
            Grid.Row="10"
            Grid.ColumnSpan="2"
            Placeholder="Vitamin-A Value"
            TextColor="DarkSlateGray" />

        <Entry
            Grid.Row="11"
            Grid.ColumnSpan="2"
            Placeholder="Vitamin-E Value"
            TextColor="DarkSlateGray" />

        <Entry
            Grid.Row="12"
            Grid.ColumnSpan="2"
            Placeholder="Vitamin-C Value"
            TextColor="DarkSlateGray" />

        <Entry
            Grid.Row="13"
            Grid.ColumnSpan="2"
            Placeholder="Potassium Value"
            TextColor="DarkSlateGray" />

        <Entry
            Grid.Row="14"
            Grid.ColumnSpan="2"
            Placeholder="Calcium Value"
            TextColor="DarkSlateGray" />

        <Entry
            Grid.Row="15"
            Grid.ColumnSpan="2"
            Placeholder="Phosporous Value"
            TextColor="DarkSlateGray" />

        <Entry
            Grid.Row="16"
            Grid.ColumnSpan="2"
            Placeholder="Iron Value"
            TextColor="DarkSlateGray" />

        <Entry
            Grid.Row="17"
            Grid.ColumnSpan="2"
            Placeholder="Magnesium Value"
            TextColor="DarkSlateGray" />

        <Entry
            Grid.Row="18"
            Grid.ColumnSpan="2"
            Placeholder="Zinc Value"
            TextColor="DarkSlateGray" />

        <Entry
            Grid.Row="19"
            Grid.ColumnSpan="2"
            Placeholder="Copper Value"
            TextColor="DarkSlateGray" />

        <Entry
            Grid.Row="20"
            Grid.ColumnSpan="2"
            Placeholder="Manganese Value"
            TextColor="DarkSlateGray" />

        <Button
            x:Name="EnterBtn"
            Grid.Row="21"
            Grid.ColumnSpan="2"
            BackgroundColor="MediumSeaGreen"
            Text="Enter Data"
            TextColor="DarkSlateGray"
            BorderColor="DarkSlateGray"
            BorderWidth="2"
            SemanticProperties.Hint="Navigates to the WeeksPage content page"
            HorizontalOptions="Center"
            VerticalOptions="Center"/>

        <Button
            x:Name="BackBtn"
            Grid.Row="22"
            Grid.ColumnSpan="2"
            BackgroundColor="MediumSeaGreen"
            Text="Go Back"
            TextColor="DarkSlateGray"
            BorderColor="DarkSlateGray"
            BorderWidth="2"
            SemanticProperties.Hint="Navigates to the WeeksPage content page"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Command="{Binding BackToWeeksCommand}"/>

    </Grid>
    </ScrollView>
</ContentPage>