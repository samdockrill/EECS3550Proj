<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutriWeekMAUI.MInputPage"
             xmlns:viewmodel="clr-namespace:NutriWeekMAUI.ViewModels"
             x:DataType="viewmodel:MInputViewModel"
             Title="Manual Input"
             BackgroundColor="White">

    <ScrollView>

    

    <Grid
    RowDefinitions="*, *, *, *, *, *, *, *, *, *, *, *, *, *, *, *, *, *, *, *, *, Auto, Auto, Auto"
    ColumnDefinitions=".45*, *"
    Padding="10"
    RowSpacing="10"
    ColumnSpacing="10">


        <Label
        Text="Enter Nutrition Info for New Food"
        FontSize="25"
        Grid.ColumnSpan="2"
        TextColor="DarkSlateGray"
        HorizontalOptions="Start"/>     


        <Label
        Text="Food Name:"
        Grid.Row="1"
        TextColor="DarkSlateGray"
        HorizontalOptions="Start"/>

        <Entry
        Grid.Row="1"
        Grid.Column="2"
        Grid.ColumnSpan="2"
        Placeholder="Food Name"
        TextColor="DarkSlateGray"
        HorizontalOptions="Start"
        BackgroundColor="MediumSeaGreen"/>

        <Label
        Text="Fat Value:"
        Grid.Row="2"
        TextColor="DarkSlateGray"
        HorizontalOptions="Start"/>

        <Entry
        Grid.Row="2"
        Grid.Column="2"
        Grid.ColumnSpan="2"
        Placeholder="0"
        HorizontalOptions="Start"
        TextColor="DarkSlateGray"
        BackgroundColor="MediumSeaGreen" />

        <Label
        Grid.Row="3"
        Grid.ColumnSpan="2"
        Text="Sat-Fat Value:"
        TextColor="DarkSlateGray"/>

        <Entry
        Grid.Row="3"
        Grid.Column="2"
        Grid.ColumnSpan="2"
        Placeholder="0"
        HorizontalOptions="Start"
        TextColor="DarkSlateGray"
        BackgroundColor="MediumSeaGreen" />

        <Label
        Grid.Row="4"
        Grid.ColumnSpan="2"
        Text="Trans-Fat Value:"
        TextColor="DarkSlateGray" />

            <Entry
        Grid.Row="4"
        Grid.Column="2"
        Grid.ColumnSpan="2"
        Placeholder="0"
        HorizontalOptions="Start"
        TextColor="DarkSlateGray"
        BackgroundColor="MediumSeaGreen" />

            <Label
        Grid.Row="5"
        Grid.ColumnSpan="2"
        Text="Cholestrerol Value:"
        TextColor="DarkSlateGray" />

            <Entry
        Grid.Row="5"
        Grid.Column="2"
        Grid.ColumnSpan="2"
        Placeholder="0"
        HorizontalOptions="Start"
        TextColor="DarkSlateGray"
        BackgroundColor="MediumSeaGreen" />

            <Label
        Grid.Row="6"
        Grid.ColumnSpan="2"
        Text="Carb Value:"
        TextColor="DarkSlateGray" />

            <Entry
        Grid.Row="6"
        Grid.Column="2"
        Grid.ColumnSpan="2"
        Placeholder="0"
        HorizontalOptions="Start"
        TextColor="DarkSlateGray"
        BackgroundColor="MediumSeaGreen" />

            <Label
        Grid.Row="7"
        Grid.ColumnSpan="2"
        Text="Sugar Value:"
        TextColor="DarkSlateGray" />

            <Entry
        Grid.Row="7"
        Grid.Column="2"
        Grid.ColumnSpan="2"
        Placeholder="0"
        HorizontalOptions="Start"
        TextColor="DarkSlateGray"
        BackgroundColor="MediumSeaGreen" />

            <Label
        Grid.Row="8"
        Grid.ColumnSpan="2"
        Text="Fiber Value:"
        TextColor="DarkSlateGray" />

            <Entry
        Grid.Row="8"
        Grid.Column="2"
        Grid.ColumnSpan="2"
        Placeholder="0"
        HorizontalOptions="Start"
        TextColor="DarkSlateGray"
        BackgroundColor="MediumSeaGreen" />

            <Label
        Grid.Row="9"
        Grid.ColumnSpan="2"
        Text="Protein Value:"
        TextColor="DarkSlateGray" />

            <Entry
        Grid.Row="9"
        Grid.Column="2"
        Grid.ColumnSpan="2"
        Placeholder="0"
        HorizontalOptions="Start"
        TextColor="DarkSlateGray"
        BackgroundColor="MediumSeaGreen" />

            <Label
        Grid.Row="10"
        Grid.ColumnSpan="2"
        Text="Sodium Value:"
        TextColor="DarkSlateGray" />

            <Entry
        Grid.Row="10"
        Grid.Column="2"
        Grid.ColumnSpan="2"
        Placeholder="0"
        HorizontalOptions="Start"
        TextColor="DarkSlateGray"
        BackgroundColor="MediumSeaGreen" />

            <Label
        Grid.Row="11"
        Grid.ColumnSpan="2"
        Text="Vitamin-A Value:"
        TextColor="DarkSlateGray" />

            <Entry
        Grid.Row="11"
        Grid.Column="2"
        Grid.ColumnSpan="2"
        Placeholder="0"
        HorizontalOptions="Start"
        TextColor="DarkSlateGray"
        BackgroundColor="MediumSeaGreen" />

            <Label
        Grid.Row="12"
        Grid.ColumnSpan="2"
        Text="Vitamin-E Value:"
        TextColor="DarkSlateGray" />

            <Entry
        Grid.Row="12"
        Grid.Column="2"
        Grid.ColumnSpan="2"
        Placeholder="0"
        HorizontalOptions="Start"
        TextColor="DarkSlateGray"
        BackgroundColor="MediumSeaGreen" />

            <Label
        Grid.Row="13"
        Grid.ColumnSpan="2"
        Text="Vitamin-C Value:"
        TextColor="DarkSlateGray" />

            <Entry
        Grid.Row="13"
        Grid.Column="2"
        Grid.ColumnSpan="2"
        Placeholder="0"
        HorizontalOptions="Start"
        TextColor="DarkSlateGray"
        BackgroundColor="MediumSeaGreen" />

            <Label
        Grid.Row="14"
        Grid.ColumnSpan="2"
        Text="Potassium Value:"
        TextColor="DarkSlateGray" />

            <Entry
        Grid.Row="14"
        Grid.Column="2"
        Grid.ColumnSpan="2"
        Placeholder="0"
        HorizontalOptions="Start"
        TextColor="DarkSlateGray"
        BackgroundColor="MediumSeaGreen" />

            <Label
        Grid.Row="15"
        Grid.ColumnSpan="2"
        Text="Calcium Value:"
        TextColor="DarkSlateGray" />

            <Entry
        Grid.Row="15"
        Grid.Column="2"
        Grid.ColumnSpan="2"
        Placeholder="0"
        HorizontalOptions="Start"
        TextColor="DarkSlateGray"
        BackgroundColor="MediumSeaGreen" />

            <Label
        Grid.Row="16"
        Grid.ColumnSpan="2"
        Text="Phosporous Value:"
        TextColor="DarkSlateGray" />

            <Entry
        Grid.Row="16"
        Grid.Column="2"
        Grid.ColumnSpan="2"
        Placeholder="0"
        HorizontalOptions="Start"
        TextColor="DarkSlateGray"
        BackgroundColor="MediumSeaGreen" />

            <Label
        Grid.Row="17"
        Grid.ColumnSpan="2"
        Text="Iron Value:"
        TextColor="DarkSlateGray" />

            <Entry
        Grid.Row="17"
        Grid.Column="2"
        Grid.ColumnSpan="2"
        Placeholder="0"
        HorizontalOptions="Start"
        TextColor="DarkSlateGray"
        BackgroundColor="MediumSeaGreen" />

            <Label
        Grid.Row="18"
        Grid.ColumnSpan="2"
        Text="Magnesium Value:"
        TextColor="DarkSlateGray" />

            <Entry
        Grid.Row="18"
        Grid.Column="2"
        Grid.ColumnSpan="2"
        Placeholder="0"
        HorizontalOptions="Start"
        TextColor="DarkSlateGray"
        BackgroundColor="MediumSeaGreen" />

            <Label
        Grid.Row="19"
        Grid.ColumnSpan="2"
        Text="Zinc Value:"
        TextColor="DarkSlateGray" />

            <Entry
        Grid.Row="19"
        Grid.Column="2"
        Grid.ColumnSpan="2"
        Placeholder="0"
        HorizontalOptions="Start"
        TextColor="DarkSlateGray"
        BackgroundColor="MediumSeaGreen" />

            <Label
        Grid.Row="20"
        Grid.ColumnSpan="2"
        Text="Copper Value:"
        TextColor="DarkSlateGray" />

            <Entry
        Grid.Row="20"
        Grid.Column="2"
        Grid.ColumnSpan="2"
        Placeholder="0"
        HorizontalOptions="Start"
        TextColor="DarkSlateGray"
        BackgroundColor="MediumSeaGreen" />

            <Label
        Grid.Row="21"
        Grid.ColumnSpan="2"
        Text="Manganese Value:"
        TextColor="DarkSlateGray" />

            <Entry
        Grid.Row="21"
        Grid.Column="2"
        Grid.ColumnSpan="2"
        Placeholder="0"
        HorizontalOptions="Start"
        TextColor="DarkSlateGray"
        BackgroundColor="MediumSeaGreen" />

            <Button
        x:Name="EnterBtn"
        Grid.Row="22"
        Grid.ColumnSpan="2"
        BackgroundColor="MediumSeaGreen"
        Text="Enter Data"
        TextColor="DarkSlateGray"
        BorderColor="DarkSlateGray"
        BorderWidth="2"
        SemanticProperties.Hint="Navigates to the WeeksPage content page"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        Command="{Binding EnterManualDataCommand}"/>

        <Button
        x:Name="BackBtn"
        Grid.Row="23"
        Grid.ColumnSpan="2"
        BackgroundColor="MediumSeaGreen"
        Text="Go Back"
        TextColor="DarkSlateGray"
        BorderColor="DarkSlateGray"
        BorderWidth="2"
        SemanticProperties.Hint="Navigates to the WeeksPage content page"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        Command="{Binding BackToDayCommand}"/>

    </Grid>
    </ScrollView>
</ContentPage>